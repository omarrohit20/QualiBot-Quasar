# Copy to .env and fill in real values. .env is git-ignored — never commit real tokens.

# Jira (Atlassian API token: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=

# Figma (personal access token: Figma > Settings > Personal access tokens)
FIGMA_API_TOKEN=

# Git provider token (repo read access for PR/branch context, if used)
GIT_TOKEN=

# App credentials per environment, as JSON: {"username":"...","password":"..."}
DEV_APP_CREDENTIALS=
QA_APP_CREDENTIALS=

# OWASP ZAP daemon (security scan of the existing @smoke UI run — see global-teardown.ts)
# Start it locally, e.g.: docker run -u zap -p 8080:8080 zaproxy/zap-stable zap.sh -daemon -port 8080 -config api.disablekey=true
ZAP_API_URL=http://127.0.0.1:8080
ZAP_PROXY_URL=http://127.0.0.1:8080
ZAP_API_KEY=

# k6 performance smoke check (single-user, 5-iteration run — see spec/performance/_template.k6.js)
# Leave unset to auto-detect the k6 binary; set to override with a Docker image if k6 isn't installed locally.
K6_DOCKER_IMAGE=grafana/k6:latest
