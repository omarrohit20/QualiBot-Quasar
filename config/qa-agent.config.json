{
  "jira": {
    "baseUrl": "https://omarrohit20.atlassian.net/",
    "email": "omarrohit20@gmail.com",
    "apiTokenEnvVar": "JIRA_API_TOKEN",
    "projectKey": "PROJ",
    "defaultIssueType": "Bug",
    "bugLabels": ["qa-automation", "auto-filed"]
  },
  "figma": {
    "apiTokenEnvVar": "FIGMA_API_TOKEN",
    "teamId": "",
    "defaultFileId": ""
  },
  "git": {
    "provider": "github",
    "repoUrl": "",
    "tokenEnvVar": "GIT_TOKEN",
    "defaultBranchPrefix": "qa/"
  },
  "environments": {
    "dev": {
      "appUrl": "https://opensource-demo.orangehrmlive.com/",
      "apiBaseUrl": "https://opensource-demo.orangehrmlive.com/web/index.php/",
      "credentialsEnvVar": "DEV_APP_CREDENTIALS"
    },
    "qa": {
      "appUrl": "https://opensource-demo.orangehrmlive.com/",
      "apiBaseUrl": "https://opensource-demo.orangehrmlive.com/web/index.php/",
      "credentialsEnvVar": "QA_APP_CREDENTIALS"
    }
  },
  "artifacts": {
    "rootDir": "qa-artifacts",
    "testPlanFile": "test-plan.md",
    "testCasesFile": "test-cases.md",
    "scriptChangesFile": "script-changes.md",
    "reportFile": "report.md",
    "jiraDraftsFile": "jira-bug-drafts.md"
  },
  "seeding": {
    "apiSeedScriptDir": "libs/seed",
    "uiSeedScriptDir": "spec/seed"
  },
  "quality": {
    "accessibility": {
      "tool": "axe-core",
      "fixture": "libs/fixtures/qaFixtures.ts",
      "scannedTag": "@smoke",
      "artifactSubdir": "accessibility"
    },
    "security": {
      "tool": "OWASP ZAP",
      "mode": "passive-proxy",
      "helper": "libs/utils/zapScan.ts",
      "scannedTag": "@smoke",
      "artifactSubdir": "security",
      "apiUrlEnvVar": "ZAP_API_URL",
      "proxyUrlEnvVar": "ZAP_PROXY_URL",
      "apiKeyEnvVar": "ZAP_API_KEY"
    },
    "performance": {
      "tool": "k6",
      "scriptDir": "spec/performance",
      "template": "spec/performance/_template.k6.js",
      "reportGenerator": "scripts/generate-perf-report.js",
      "artifactSubdir": "performance",
      "vus": 1,
      "iterations": 5,
      "dockerImage": "grafana/k6:latest",
      "dockerImageEnvVar": "K6_DOCKER_IMAGE"
    }
  }
}
